# Configure actual values in hosted runtime secrets; never commit real credentials.
# Full published Astron workflow endpoint, not just origin.
ASTRON_SERVICE_URL=
ASTRON_FLOW_ID=
ASTRON_API_KEY=
ASTRON_API_SECRET=
ASTRON_INPUT_NAME=AGENT_USER_INPUT
# OpenAI-compatible base including /v1. The model must match your deployment.
SPARK_BASE_URL=
SPARK_MODEL=spark-x2.6-4b
SPARK_API_KEY=
# Raw CN API key, without Bearer prefix.
AHOLO_API_KEY=
